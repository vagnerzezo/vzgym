generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Treino {
  id           String            @id @default(cuid())
  nome         String
  ordem        Int               @default(0)
  exercicios   Exercicio[]
  checkins     TrainingCheckin[]
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt

  @@index([ordem])
}

/// Check-in diário (estilo TotalPass). userId prepara multi-usuário; app atual usa "default".
model TrainingCheckin {
  id          String   @id @default(cuid())
  userId      String   @default("default") @map("user_id")
  treinoId    String?  @map("workout_id")
  treino      Treino?  @relation(fields: [treinoId], references: [id], onDelete: SetNull)
  checkinDate DateTime @map("checkin_date") @db.Date
  weekday     Int
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, checkinDate])
  @@index([userId])
  @@index([treinoId])
  @@index([checkinDate])
  @@map("training_checkins")
}

model Tecnica {
  id             String      @id @default(cuid())
  nome           String      @unique
  descricao      String      @db.Text
  comoExecutar   String      @map("como_executar") @db.Text
  beneficios     String      @db.Text
  quandoUtilizar String?     @map("quando_utilizar") @db.Text
  observacoes    String?     @db.Text
  exercicios     Exercicio[]
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @updatedAt
}

model Exercicio {
  id           String   @id @default(cuid())
  treinoId     String   @map("treino_id")
  treino       Treino   @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  nome         String
  series       String
  tecnicaId    String?  @map("tecnica_id")
  tecnica      Tecnica? @relation(fields: [tecnicaId], references: [id], onDelete: SetNull)
  video        String?
  musculo      String
  passoAPasso  String?  @map("passo_a_passo") @db.Text
  dicas        String?  @db.Text
  observacoes  String?  @db.Text
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([treinoId])
  @@index([tecnicaId])
  @@index([ordem])
}
