# Banco de dados (PostgreSQL — ex: Neon)
DATABASE_URL="postgresql://usuario:senha@host/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://usuario:senha@host-direct/neondb?sslmode=require"

# Servidor Express (local: 3002 — no Railway NÃO defina PORT)
PORT=3002

# Painel admin (opcional — default: vagnerzezo)
# ADMIN_SECRET="vagnerzezo"

# Railway: remova &channel_binding=require das URLs se a conexão falhar
# DIRECT_DATABASE_URL deve usar a URL direct do Neon (sem -pooler)
