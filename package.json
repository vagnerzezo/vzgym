{
  "name": "vzgym",
  "version": "1.0.0",
  "description": "Gerenciador de fichas de treino de academia",
  "main": "src/serve.js",
  "scripts": {
    "prestart": "npm run prisma:generate",
    "start": "node src/serve.js",
    "dev": "nodemon src/serve.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:all": "concurrently -n api,web -c blue,green \"nodemon src/serve.js\" \"npm run dev --prefix frontend\"",
    "build": "npm run prisma:generate",
    "prisma:generate": "HOME=\"$(pwd)/.prisma-home\" prisma generate",
    "deploy:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "postinstall": "npm run prisma:generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.3",
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1"
  }
}
